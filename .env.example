# 9Router Hardened Enterprise-Personal Runtime Contract
# All required secrets are enforced fail-closed at runtime (skipped during `next build`).

# REQUIRED (>= 32 chars high-entropy random string: `openssl rand -hex 32`)
JWT_SECRET=
API_KEY_SECRET=

# REQUIRED (exact 32 bytes: 64 hex chars via `openssl rand -hex 32`)
ENCRYPTION_KEY=

# REQUIRED on first boot (>= 12 chars, or provide bcrypt hash via ADMIN_PASSWORD_HASH)
ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=

# Reverse Proxy & Network Hardening
# Strict default: 127.0.0.1,::1 — explicitly add your Caddy/Nginx/Traefik container IP/CIDR
TRUSTED_PROXY_IPS=127.0.0.1,::1
AUTH_COOKIE_SECURE=true

# Explicit allowlist for self-hosted upstreams (e.g. ollama:11434,192.168.1.50:8000)
# Never applies to end-user media prefetch URLs (Tier 1 SSRF guard has zero exceptions).
SELFHOSTED_HOST_ALLOWLIST=

# Storage & Runtime
DATA_DIR=/app/data
PORT=20128
HOSTNAME=0.0.0.0
NODE_ENV=production
SESSION_TTL_HOURS=12
LOG_LEVEL=info
